---
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
---
<Base title="Link nieważny" description="Link potwierdzający zapis do newslettera wygasł lub został już użyty.">
  <section class="wrap page">
    <h1>Ten link już nie działa</h1>
    <p class="lead">Link potwierdzający jest ważny przez 7 dni i działa tylko raz. Jeśli zapis został już potwierdzony, nic więcej nie musisz robić. Jeśli nie, zapisz się ponownie, a wyślemy nowy link.</p>
    <NewsletterForm id="ponownie" />
  </section>
</Base>

<style>
  .page { padding-block: clamp(3rem, 10vw, 7rem); max-width: 44rem; }
</style>
