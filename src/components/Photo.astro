---
// Zdjęcie z automatycznymi wersjami AVIF/WebP w kilku szerokościach.
// Kadr ustawiamy proporcją (ratio) i punktem zaczepienia (position).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  position?: string;
  caption?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const {
  src, alt, ratio = '3 / 2', position = 'center', caption,
  sizes = '(max-width: 56rem) 100vw, 50vw', eager = false, class: cls,
} = Astro.props;
const widths = [480, 800, 1200, 1800, 2400].filter((w) => w <= src.width);
---
<figure class:list={['photo', cls]} style={`--ratio: ${ratio}; --pos: ${position}`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo { margin: 0; }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    object-position: var(--pos);
    background: var(--shoal);
  }
  figcaption { font-size: var(--step--1); color: var(--steel); padding-top: 0.45rem; }
</style>
