---
// Wykaz etapów sezonu, jak tabela w locji: kolejność, trasa, termin, dni, cena, status.
import { getCollection } from 'astro:content';
interface Props { sezon: number }
const { sezon } = Astro.props;
const etapy = (await getCollection('etapy', ({ data }) => data.sezon === sezon))
  .sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const statusLabel = {
  zapowiedz: 'Zapisy od stycznia',
  zapisy: 'Zapisy otwarte',
  ostatnie: 'Ostatnie koje',
  pelny: 'Komplet',
  zakonczony: 'Zakończony',
} as const;
const pln = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN', maximumFractionDigits: 0 });
---
<ol class="ledger">
  {etapy.map((e) => (
    <li>
      <span class="no" aria-hidden="true">{e.data.kolejnosc}</span>
      <div class="what">
        <h3>{e.data.title}</h3>
        <p class="route"><span class="place">{e.data.portStart}</span> do <span class="place">{e.data.portKoniec}</span>, {e.data.termin}</p>
        <p class="desc">{e.data.skrot}</p>
      </div>
      <dl class="facts">
        <div><dt>Dni</dt><dd>{e.data.dni}</dd></div>
        <div><dt>Koja</dt><dd>{pln.format(e.data.cena)}</dd></div>
        <div><dt>Status</dt><dd class:list={['status', e.data.status]}>{statusLabel[e.data.status]}</dd></div>
      </dl>
    </li>
  ))}
</ol>

<style>
  .ledger { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(14rem, auto);
    gap: 0.5rem 1.5rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .no {
    font-family: var(--font-display);
    font-stretch: 70%;
    font-weight: 800;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--magenta);
  }
  h3 { margin-bottom: 0.25rem; }
  .route { margin: 0 0 0.4rem; color: var(--steel); }
  .desc { margin: 0; }
  .facts { margin: 0; display: grid; gap: 0.2rem; font-size: var(--step--1); }
  .facts div { display: flex; justify-content: space-between; gap: 1rem; }
  dt { color: var(--steel); }
  dd { margin: 0; font-family: var(--font-display); font-stretch: 85%; font-weight: 650; font-size: 1rem; }
  .status.zapisy, .status.ostatnie { color: var(--magenta); }
  @media (max-width: 44rem) {
    li { grid-template-columns: 2.2rem minmax(0, 1fr); }
    .facts { grid-column: 2; }
  }
</style>
